# All channels OFF; default CLI run is dry-run even after configuring channels.
NOTIFIER_CHANNELS=
NOTIFIER_STATE_DIR=./state
NOTIFIER_POLL_SECONDS=600
# SMTP uses your own TLS credentials. No OAuth/connector credentials are reused.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=465
SMTP_TLS=ssl
SMTP_USERNAME=replace-locally
SMTP_PASSWORD=replace-locally
SMTP_SENDER=sender@example.invalid
SMTP_RECIPIENT=recipient@example.invalid
# wx-bot must be separately installed/paired by its owner. Never expose its API.
WXBOT_BASE_URL=http://127.0.0.1:18790
WXBOT_TOKEN=replace-locally
WXBOT_BINDING=replace-locally
WXBOT_RECIPIENT=replace-locally
